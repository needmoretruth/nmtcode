<!DOCTYPE html>
{{!--
  Template of THIRD-PARTY-LICENSES.html, for cargo-about 0.9.2 (scripts/package.sh checks the version).

  It lists only crates with a source (crates.io). The crates of this workspace have no source and
  are left out: their licence is LICENSE-MIT and LICENSE-APACHE beside this file.

  cargo-about puts every crate whose licence text is the same under one licence entry, and sorts
  the crates of an entry by package id. A workspace crate's id starts with "path+", which sorts
  before a crates.io crate's "registry+", so the last crate of an entry has a source exactly when
  the entry has at least one crate from crates.io. That is the test below.
--}}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Third-party licenses · NMT Code</title>
<style>
  :root {
    --n-bg: #EEF0F3;
    --n-surface: #F7F8FA;
    --n-text: #1A1D22;
    --n-muted: #4A5059;
    --n-line: #D6DAE0;
    --n-link: #1F62C2;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --n-bg: #0E1014;
      --n-surface: #15181E;
      --n-text: #E6E8EC;
      --n-muted: #B3B9C4;
      --n-line: #262B33;
      --n-link: #8FC3FF;
    }
  }
  html { background: var(--n-bg); color: var(--n-text); }
  body {
    margin: 0 auto;
    padding: 48px 16px 96px;
    max-width: 72ch;
    font: 400 16px/1.6 Inter, "Noto Sans KR", system-ui, -apple-system, "Segoe UI", sans-serif;
    overflow-wrap: anywhere;
  }
  @media (min-width: 1440px) { body { font-size: clamp(16px, 1.11vw, 20px); } }
  h1 { font-weight: 600; font-size: 1.75em; line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 16px; }
  h2 { font-weight: 500; font-size: 1.125em; line-height: 1.3; letter-spacing: -0.01em; margin: 0 0 8px; }
  p { margin: 0 0 16px; }
  .muted { color: var(--n-muted); }
  a { color: var(--n-link); }
  a:focus-visible { outline: 2px solid var(--n-link); outline-offset: 2px; border-radius: 4px; }
  ul { margin: 0 0 16px; padding-left: 1.25em; }
  li { margin: 4px 0; }
  section { border-top: 1px solid var(--n-line); padding-top: 24px; margin-top: 32px; }
  pre {
    margin: 0;
    padding: 16px;
    background: var(--n-surface);
    border: 1px solid var(--n-line);
    border-radius: 12px;
    font: inherit;
    font-size: 0.875em;
    line-height: 1.5;
    white-space: pre-wrap;
  }
</style>
</head>
<body>
<main>
<h1>Third-party licenses</h1>
<p>This program includes the crates listed below. Each crate is used under the license shown with
it, and the full text of every license follows.</p>
<p class="muted">NMT Code itself is licensed under MIT or Apache-2.0, at your choice; see
LICENSE-MIT and LICENSE-APACHE.</p>

<h2 id="crates">Crates</h2>
<ul>
{{#each crates}}{{#if package.source}}
  <li><a href="https://crates.io/crates/{{package.name}}/{{package.version}}">{{package.name}} {{package.version}}</a> · <span class="muted">{{license}}</span></li>
{{~/if}}{{/each}}
</ul>
{{#each licenses}}{{#each used_by}}{{#if @last}}{{#if crate.source}}

<section id="license-{{@../index}}">
<h2>{{../name}} <span class="muted">({{../id}})</span></h2>
<p class="muted">Used by: {{#each ../used_by}}{{#if crate.source}}{{crate.name}} {{crate.version}}{{#unless @last}}, {{/unless}}{{/if}}{{/each}}</p>
<pre>{{../text}}</pre>
</section>
{{~/if}}{{/if}}{{/each}}{{/each}}

</main>
</body>
</html>
